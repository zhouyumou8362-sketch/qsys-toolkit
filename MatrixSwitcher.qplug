-- ============================================================================
-- MatrixSwitcher  Q-SYS Plugin (Framework version)
-- ----------------------------------------------------------------------------
-- 通用矩阵切换器：通过 TCP 向矩阵设备发送切换命令。
--
-- 功能：
--   1) 输入/输出名字可自定义（Config 页运行时文本框，实时刷新按钮文字）
--   2) 输入/输出数量可自定义（Num Inputs / Num Outputs 属性，默认 8x8 最大 16x16）
--   3) 先点输出布防(arm)，再点输入路由到该输出
--   4) 点输入可高亮显示它当前馈送的输出
--   5) 输入/输出代码分开自定义；Config 页用 {I}/{O} 模板拼接生成最终切换命令，
--      顺序与前后缀完全自由（例：IN{I} OUT{O}\r 或 {O}*{I}）
--
-- 设计期配置（Properties，运行时只读）：
--   Num Inputs / Num Outputs / IP Address / Port / Auto Reconnect / Reconnect Interval / Disable Internal Send
-- 运行期面板（Main/Config 两页）见 GetControlLayout。
-- 引出引脚：Cmd Out Raw（原始命令，含 \r\n）/ Cmd Out Hex（\xNN 转义，可直接接 Command Buttons）/ Send Trig（命令变化时脉冲，v1.0.1）。
-- ============================================================================

PluginInfo = {
    Name        = "ZYM_personal_plug~MatrixSwitcher",
    Version     = "1.0.10",
    BuildVersion = "1.0.10",
    Id          = "659fd500-b5d8-4350-88f5-f0b7cb193574",
    Author      = "Zhouyumou",
    Description = "通用矩阵切换器（TCP，{I}/{O} 模板拼接命令，默认8x8最大16x16）",
}

